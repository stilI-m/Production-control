# ==========================================
# Настройки приложения (FastAPI)
# ==========================================
APP_PORT=8000
ENVIRONMENT=development  # development, production, testing
LOG_LEVEL=INFO

# ==========================================
# База данных (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=manufacturing_db

# ==========================================
# Очереди задач (Celery / RabbitMQ / Redis)
# ==========================================
# Пример для Redis: redis://localhost:6379/0
# Пример для RabbitMQ: amqp://guest:guest@localhost:5672//
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==========================================
# Файловое хранилище (MinIO / S3)
# ==========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=minioadmin123

# ==========================================
# Настройки Webhooks
# ==========================================
# Секретный ключ для подписи вебхуков (HMAC)
WEBHOOK_SECRET=your_super_secret_key_here